---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Layout from '../layouts/Layout.astro';
---
<Layout>

<!-- ============ HERO ============ -->
<section class='hero'>
	<div class='container hero-grid'>
		<div class='hero-copy'>
			<p class='eyebrow'>Desde 2019 · Cultivadas con cariño</p>
			<h1>Trae la <em>calma</em> del jardín al interior.</h1>
			<p class='lead'>
				Una pequeña tienda-estudio de plantas seleccionadas a mano, macetas artesanales y
				todo lo que necesitan para prosperar. Entregadas enraizadas, sanas y listas.
			</p>
			<div class='hero-actions'>
				<a href='#collection' class='btn'>Explorar la colección</a>
				<a href='#care' class='btn btn-ghost'>Guía de cuidados</a>
			</div>
			<ul class='hero-facts'>
				<li><strong>120+</strong><span>Variedades</span></li>
				<li><strong>30 días</strong><span>Garantía de la planta</span></li>
				<li><strong>Local</strong><span>Entrega al día siguiente</span></li>
			</ul>
		</div>

		<!-- IMAGE PLACEHOLDER — replace src with your hero photo (recommended 1200×1500) -->
		<figure class='hero-image ph ph-portrait'>
			<img
				src='/fotos/_MG_7375.JPG'
				alt='Hoja de Monstera en una maceta de cerámica'
				loading='eager'
			/>			
		</figure>
	</div>
</section>

<!-- ============ MARQUEE / VALUES ============ -->
<section class='strip'>
	<div class='container strip-inner'>
		<span>Sustrato sin turba</span>
		<span>Embalaje sin plástico</span>
		<span>Cultivado en nuestro propio vivero</span>
		<span>Servicio de trasplante gratuito</span>
	</div>
</section>

<!-- ============ COLLECTION ============ -->
<section id='collection' class='section'>
	<div class='container'>
		<header class='section-head'>
			<p class='eyebrow'>La colección</p>
			<h2>Plantas escogidas para hogares reales</h2>
			<p class='section-sub'>
				Favoritas de bajo mantenimiento y algunas plantas raras — cada una criada en nuestro
				vivero y adaptada a la luz que realmente tienes.
			</p>
		</header>

		<div class='cards'>
			<article class='card'>
				<!-- IMAGE PLACEHOLDER — 800×900 -->
				<figure class='ph ph-square'>
					<img
						src='/fotos/IMG_7301.JPG'
						alt='Monstera Deliciosa'
						loading='lazy'
					/>					
				</figure>
				<div class='card-body'>
					<h3>Monstera Deliciosa</h3>
					<p>Luz indirecta brillante · Fácil</p>
					<p class='price'>€38</p>
				</div>
			</article>

			<article class='card'>
				<!-- IMAGE PLACEHOLDER — 800×900 -->
				<figure class='ph ph-square'>
					<img src='/fotos/IMG_7312.JPG' alt='Fiddle Leaf Fig' loading='lazy' />
				</figure>
				<div class='card-body'>
					<h3>Fiddle Leaf Fig</h3>
					<p>Luz intensa · Moderado</p>
					<p class='price'>€54</p>
				</div>
			</article>

			<article class='card'>
				<!-- IMAGE PLACEHOLDER — 800×900 -->
				<figure class='ph ph-square'>
					<img src='/fotos/IMG_7288.JPG' alt='Snake Plant' loading='lazy' />
				</figure>
				<div class='card-body'>
					<h3>Sansevieria</h3>
					<p>Cualquier luz · Casi imposible de matar</p>
					<p class='price'>€26</p>
				</div>
			</article>

			<article class='card'>
				<!-- IMAGE PLACEHOLDER — 800×900 -->
				<figure class='ph ph-square'>
					<img
						src='/fotos/IMG_7304.JPG'
						alt='Calathea Orbifolia'
						loading='lazy'
					/>					
				</figure>
				<div class='card-body'>
					<h3>Calathea Orbifolia</h3>
					<p>Tolerante a la sombra · Le encanta la humedad</p>
					<p class='price'>€42</p>
				</div>
			</article>
		</div>

		<p class='center'><a href='#' class='link-arrow'>Ver las 120 plantas</a></p>
	</div>
</section>

<!-- ============ STORY ============ -->
<section id='story' class='section section-tint'>
	<div class='container split'>
		<!-- IMAGE PLACEHOLDER — 1000×1200 -->
		<figure class='ph ph-portrait'>
			<img
				src='/fotos/IMG_7320.JPG'
				alt='Inside the Casa Verde greenhouse'
				loading='lazy'
			/>			
		</figure>

		<div class='split-copy'>
			<p class='eyebrow'>Nuestra historia</p>
			<h2>Un invernadero, dos personas y mucha paciencia</h2>
			<p>
				Casa Verde empezó en una azotea con una docena de esquejes y una regadera.
				Hoy cultivamos la mayor parte de lo que vendemos en un pequeño invernadero
				cerca de la ciudad — despacio, sin atajos, para que las plantas que llegan a ti
				ya estén habituadas a vivir en interiores.
			</p>
			<p>
				Ven un sábado. Trasplantaremos gratis cualquier planta que traigas,
				y probablemente te iremos a casa con un esqueje.
			</p>
			<a href='#visit' class='link-arrow'>Encontrar la tienda</a>
		</div>
	</div>
</section>

<!-- ============ CARE ============ -->
<section id='care' class='section'>
	<div class='container'>
		<header class='section-head'>
			<p class='eyebrow'>Cuidados</p>
			<h2>Tres cosas, bien hechas</h2>
		</header>

		<div class='steps'>
			<article class='step'>
				<span class='step-num'>01</span>
				<h3>Primero la luz, después el riego</h3>
				<p>
					Coloca la planta según la ventana. Nueve de cada diez problemas empiezan por el sitio equivocado,
					no por la regadera.
				</p>
			</article>
			<article class='step'>
				<span class='step-num'>02</span>
				<h3>Riega a fondo, con poca frecuencia</h3>
				<p>
					Empapa hasta que drene y luego espera a que los primeros centímetros se sequen.
					Las raíces necesitan aire tanto como humedad.
				</p>
			</article>
			<article class='step'>
				<span class='step-num'>03</span>
				<h3>Trasplanta cada segunda primavera</h3>
				<p>
					Mezcla nueva sin turba, una talla más. Tráela y lo haremos contigo
					en la tienda.
				</p>
			</article>
		</div>
	</div>
</section>

<!-- ============ QUOTE ============ -->
<section class='quote-section'>
	<div class='container'>
			<blockquote>
			“Las plantas más sanas que he llevado a casa — y la única tienda que
			me preguntó por mis ventanas antes de venderme algo.”
		</blockquote>
		<p class='quote-by'>Marta L. — cliente desde 2021</p>
	</div>
</section>

<!-- ============ VISIT / CTA ============ -->
<section id='visit' class='section'>
	<div class='container split split-reverse'>
		<!-- IMAGE PLACEHOLDER — 1200×900 -->
		<figure class='ph ph-landscape'>
			<img src='/fotos/IMG_7343.JPG' alt='Casa Verde shopfront' loading='lazy' />			
		</figure>

		<div class='split-copy'>
			<p class='eyebrow'>Visítanos</p>
			<h2>Carrer de les Flors 12, Barcelona</h2>
			<p class='hours'>
				Martes – Viernes &nbsp;10:00 – 19:00<br />
				Sábado &nbsp;10:00 – 15:00<br />
				Domingo &amp; Lunes &nbsp;cerrado
			</p>
			<form class='signup' onsubmit='return false;'>
				<label for='email'>Recibe la carta estacional de cuidados</label>
				<div class='signup-row'>
					<input
						id='email'
						type='email'
						placeholder='tu@email.com'
						required
					/>
					<button type='submit' class='btn'>Suscribirse</button>
				</div>
				<p class='fineprint'>Un correo por estación. Nunca spam.</p>
			</form>
		</div>
	</div>
</section>

</Layout>
