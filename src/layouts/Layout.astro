---
import "../styles/global.css";

---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Casa Verde — Plantas para un hogar vivo</title>
  <meta name="description" content="Casa Verde es una pequeña tienda de plantas que ofrece plantas de interior cuidadosamente cultivadas, macetas y artículos esenciales para su cuidado.">
  
  <link rel="icon" href="/public/favicon.png?v=2" sizes="32x32" />
  <link rel="icon" href="/public/favicon.png?v=2" sizes="192x192" />
  <link rel="apple-touch-icon" href="/public/favicon.png?v=2" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ============ HEADER ============ -->
  <header class="site-header">
    <nav class="nav container">
      <a class="logo" href="#top">
        <span class="logo-mark" aria-hidden="true"></span>
        Casa&nbsp;<em>Verde</em>
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
      <label for="nav-toggle" class="nav-burger" aria-label="Menú"><span></span></label>

      <ul class="nav-links">
        <li><a href="#collection">Colección</a></li>
        <li><a href="#story">Nuestra historia</a></li>
        <li><a href="#care">Cuidados</a></li>
        <li><a href="#visit">Visítanos</a></li>
      </ul>

      <a href="#collection" class="btn btn-small">Comprar plantas</a>
    </nav>
  </header>

  <main id="top">
		<slot />
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <a class="logo logo-light" href="#top">
          <span class="logo-mark" aria-hidden="true"></span>
          Casa&nbsp;<em>Verde</em>
        </a>
        <p class="footer-note">Plantas para un hogar vivo.<br>Cultivadas cerca de Barcelona.</p>
      </div>

      <nav class="footer-col">
        <h4>Tienda</h4>
        <a href="#collection">Todas las plantas</a>
        <a href="#">Macetas y tiestos</a>
        <a href="#">Tarjetas regalo</a>
      </nav>

      <nav class="footer-col">
        <h4>Ayuda</h4>
        <a href="#care">Guía de cuidados</a>
        <a href="#">Envíos</a>
        <a href="#">Garantía de las plantas</a>
      </nav>

      <nav class="footer-col">
        <h4>Síguenos</h4>
        <a href="#">Instagram</a>
        <a href="#">Pinterest</a>
        <a href="mailto:hola@casaverde.com">hola@casaverde.com</a>
      </nav>
    </div>

    <div class="container footer-base">
      <p>© 2026 Casa Verde. Todos los derechos reservados.</p>
      <p><a href="#">Privacidad</a> · <a href="#">Términos</a></p>
    </div>
  </footer>

</body>
</html>

