---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Casa Verde — Plants for a living home</title>
  <meta name="description" content="Casa Verde is a small plant shop offering carefully grown houseplants, pots and care essentials.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ============ HEADER ============ -->
  <header class="site-header">
    <nav class="nav container">
      <a class="logo" href="#top">
        <span class="logo-mark" aria-hidden="true"></span>
        Casa&nbsp;<em>Verde</em>
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
      <label for="nav-toggle" class="nav-burger" aria-label="Menu"><span></span></label>

      <ul class="nav-links">
        <li><a href="#collection">Collection</a></li>
        <li><a href="#story">Our story</a></li>
        <li><a href="#care">Care</a></li>
        <li><a href="#visit">Visit</a></li>
      </ul>

      <a href="#collection" class="btn btn-small">Shop plants</a>
    </nav>
  </header>

  <main id="top">

    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Est. 2019 · Grown with care</p>
          <h1>Bring the <em>quiet</em> of the garden indoors.</h1>
          <p class="lead">
            A small studio shop of hand-selected houseplants, handmade pots and
            everything they need to thrive. Delivered rooted, healthy and ready.
          </p>
          <div class="hero-actions">
            <a href="#collection" class="btn">Explore the collection</a>
            <a href="#care" class="btn btn-ghost">Care guide</a>
          </div>
          <ul class="hero-facts">
            <li><strong>120+</strong><span>Varieties</span></li>
            <li><strong>30 days</strong><span>Plant guarantee</span></li>
            <li><strong>Local</strong><span>Next-day delivery</span></li>
          </ul>
        </div>

        <!-- IMAGE PLACEHOLDER — replace src with your hero photo (recommended 1200×1500) -->
        <figure class="hero-image ph ph-portrait">
          <img src="images/hero-plant.jpg" alt="Monstera leaf in a ceramic pot" loading="eager">
          <figcaption class="ph-label">1200 × 1500 — hero</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ MARQUEE / VALUES ============ -->
    <section class="strip">
      <div class="container strip-inner">
        <span>Peat-free soil</span>
        <span>Plastic-free packaging</span>
        <span>Grown in our own nursery</span>
        <span>Free repotting service</span>
      </div>
    </section>

    <!-- ============ COLLECTION ============ -->
    <section id="collection" class="section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">The collection</p>
          <h2>Plants chosen for real homes</h2>
          <p class="section-sub">
            Low-fuss favourites and a few rare finds — each one raised in our nursery
            and matched to the light you actually have.
          </p>
        </header>

        <div class="cards">

          <article class="card">
            <!-- IMAGE PLACEHOLDER — 800×900 -->
            <figure class="ph ph-square">
              <img src="images/plant-1.jpg" alt="Monstera Deliciosa" loading="lazy">
              <figcaption class="ph-label">800 × 900</figcaption>
            </figure>
            <div class="card-body">
              <h3>Monstera Deliciosa</h3>
              <p>Bright indirect light · Easy</p>
              <p class="price">€38</p>
            </div>
          </article>

          <article class="card">
            <!-- IMAGE PLACEHOLDER — 800×900 -->
            <figure class="ph ph-square">
              <img src="images/plant-2.jpg" alt="Fiddle Leaf Fig" loading="lazy">
              <figcaption class="ph-label">800 × 900</figcaption>
            </figure>
            <div class="card-body">
              <h3>Fiddle Leaf Fig</h3>
              <p>Bright light · Moderate</p>
              <p class="price">€54</p>
            </div>
          </article>

          <article class="card">
            <!-- IMAGE PLACEHOLDER — 800×900 -->
            <figure class="ph ph-square">
              <img src="images/plant-3.jpg" alt="Snake Plant" loading="lazy">
              <figcaption class="ph-label">800 × 900</figcaption>
            </figure>
            <div class="card-body">
              <h3>Sansevieria</h3>
              <p>Any light · Almost unkillable</p>
              <p class="price">€26</p>
            </div>
          </article>

          <article class="card">
            <!-- IMAGE PLACEHOLDER — 800×900 -->
            <figure class="ph ph-square">
              <img src="images/plant-4.jpg" alt="Calathea Orbifolia" loading="lazy">
              <figcaption class="ph-label">800 × 900</figcaption>
            </figure>
            <div class="card-body">
              <h3>Calathea Orbifolia</h3>
              <p>Shade tolerant · Loves humidity</p>
              <p class="price">€42</p>
            </div>
          </article>

        </div>

        <p class="center"><a href="#" class="link-arrow">See all 120 plants</a></p>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section id="story" class="section section-tint">
      <div class="container split">
        <!-- IMAGE PLACEHOLDER — 1000×1200 -->
        <figure class="ph ph-portrait">
          <img src="images/story.jpg" alt="Inside the Casa Verde greenhouse" loading="lazy">
          <figcaption class="ph-label">1000 × 1200 — story</figcaption>
        </figure>

        <div class="split-copy">
          <p class="eyebrow">Our story</p>
          <h2>A greenhouse, two people and a lot of patience</h2>
          <p>
            Casa Verde began on a rooftop with a dozen cuttings and a watering can.
            Today we grow most of what we sell in a small glasshouse just outside the
            city — slowly, without shortcuts, so the plants that reach you are already
            used to living indoors.
          </p>
          <p>
            Come by on a Saturday. We'll repot anything you bring, free of charge, and
            probably send you home with a cutting.
          </p>
          <a href="#visit" class="link-arrow">Find the shop</a>
        </div>
      </div>
    </section>

    <!-- ============ CARE ============ -->
    <section id="care" class="section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Care</p>
          <h2>Three things, done well</h2>
        </header>

        <div class="steps">
          <article class="step">
            <span class="step-num">01</span>
            <h3>Light before water</h3>
            <p>Match the plant to the window. Nine problems in ten start as the wrong spot, not the wrong watering can.</p>
          </article>
          <article class="step">
            <span class="step-num">02</span>
            <h3>Water deeply, rarely</h3>
            <p>Soak until it drains, then wait until the top few centimetres are dry. Roots need air as much as moisture.</p>
          </article>
          <article class="step">
            <span class="step-num">03</span>
            <h3>Repot every second spring</h3>
            <p>Fresh peat-free mix, one size up. Bring it in and we'll do it with you at the shop.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ QUOTE ============ -->
    <section class="quote-section">
      <div class="container">
        <blockquote>
          “The healthiest plants I've ever brought home — and the only shop that asked
          about my windows before selling me anything.”
        </blockquote>
        <p class="quote-by">Marta L. — customer since 2021</p>
      </div>
    </section>

    <!-- ============ VISIT / CTA ============ -->
    <section id="visit" class="section">
      <div class="container split split-reverse">
        <!-- IMAGE PLACEHOLDER — 1200×900 -->
        <figure class="ph ph-landscape">
          <img src="images/shop.jpg" alt="Casa Verde shopfront" loading="lazy">
          <figcaption class="ph-label">1200 × 900 — shopfront</figcaption>
        </figure>

        <div class="split-copy">
          <p class="eyebrow">Visit us</p>
          <h2>Carrer de les Flors 12, Barcelona</h2>
          <p class="hours">
            Tuesday – Friday &nbsp;10:00 – 19:00<br>
            Saturday &nbsp;10:00 – 15:00<br>
            Sunday &amp; Monday &nbsp;closed
          </p>
          <form class="signup" onsubmit="return false;">
            <label for="email">Get the seasonal care letter</label>
            <div class="signup-row">
              <input id="email" type="email" placeholder="your@email.com" required>
              <button type="submit" class="btn">Subscribe</button>
            </div>
            <p class="fineprint">One email a season. No spam, ever.</p>
          </form>
        </div>
      </div>
    </section>

  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <a class="logo logo-light" href="#top">
          <span class="logo-mark" aria-hidden="true"></span>
          Casa&nbsp;<em>Verde</em>
        </a>
        <p class="footer-note">Plants for a living home.<br>Grown just outside Barcelona.</p>
      </div>

      <nav class="footer-col">
        <h4>Shop</h4>
        <a href="#collection">All plants</a>
        <a href="#">Pots &amp; planters</a>
        <a href="#">Gift cards</a>
      </nav>

      <nav class="footer-col">
        <h4>Help</h4>
        <a href="#care">Care guide</a>
        <a href="#">Shipping</a>
        <a href="#">Plant guarantee</a>
      </nav>

      <nav class="footer-col">
        <h4>Follow</h4>
        <a href="#">Instagram</a>
        <a href="#">Pinterest</a>
        <a href="mailto:hola@casaverde.com">hola@casaverde.com</a>
      </nav>
    </div>

    <div class="container footer-base">
      <p>© 2026 Casa Verde. All rights reserved.</p>
      <p><a href="#">Privacy</a> · <a href="#">Terms</a></p>
    </div>
  </footer>

</body>
</html>

